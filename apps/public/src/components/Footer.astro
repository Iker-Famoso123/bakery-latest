---
import type { SettingsDto } from '@rf/types';
import { now } from '@rf/types';
import { SocialIcon } from '@rf/ui';
import { whatsappLink } from '../lib/format';

interface Props {
  settings: SettingsDto | null;
}
const { settings } = Astro.props;
const year = now().year;
---

<!-- Cierre formal: la variante oscura del logotipo sobre chocolate de marca -->
<footer class="mt-16 bg-chocolate text-white/70">
  <div class="mx-auto grid max-w-5xl gap-10 px-5 py-14 sm:grid-cols-3">
    <div>
      <img
        src="/brand/logo-oscuro.png"
        alt="Repostería Famoso, desde 1960"
        class="w-44 max-w-full"
        width="1000"
        height="752"
        loading="lazy"
      />
      <p class="mt-4 text-sm">Pan dulce y repostería, hecho en casa.</p>
    </div>

    {
      settings && (settings.whatsapp || settings.telefono || settings.direccion) ? (
        <div class="text-sm">
          <p class="mb-3 font-semibold text-rosa-logo">Contacto</p>
          <ul class="flex flex-col gap-1.5">
            {settings.whatsapp ? (
              <li>
                <a
                  class="transition-colors duration-200 hover:text-white"
                  href={whatsappLink(settings.whatsapp)}
                >
                  WhatsApp: {settings.whatsapp}
                </a>
              </li>
            ) : null}
            {settings.telefono ? <li>Tel: {settings.telefono}</li> : null}
            {settings.direccion ? <li>{settings.direccion}</li> : null}
          </ul>
        </div>
      ) : null
    }

    {
      settings && settings.redes.length > 0 ? (
        <div class="text-sm">
          <p class="mb-3 font-semibold text-rosa-logo">Síguenos</p>
          <ul class="flex flex-col gap-1.5">
            {settings.redes.map((red) => (
              <li>
                <a
                  class="inline-flex items-center gap-2 transition-colors duration-200 hover:text-white"
                  href={red.url}
                  rel="noopener noreferrer"
                >
                  <SocialIcon tipo={red.tipo} size={14} />
                  {red.tipo}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ) : null
    }
  </div>

  <div class="border-t border-white/10 py-4 text-center text-xs text-white/50">
    © {year} Repostería Famoso · Desde 1960
  </div>
</footer>
